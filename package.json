{
  "name": "linqora-books",
  "private": true,
  "version": "0.2.0",
  "description": "Linqora Books \u2014 small-business accounting and profit/loss tracking",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @linqora-books/mobile dev",
    "build": "pnpm --filter @linqora-books/mobile build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --no-bail test",
    "e2e": "pnpm --filter @linqora-books/mobile e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "android:sync": "pnpm --filter @linqora-books/mobile android:sync",
    "android:debug": "pnpm --filter @linqora-books/mobile android:debug",
    "android:debug:preview": "pnpm --filter @linqora-books/mobile android:debug:preview",
    "test:db": "pnpm --filter @linqora-books/supabase test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
