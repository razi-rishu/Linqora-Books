# Linqora Books — build configuration (copy to the file named below; never commit real values)
#
# CLOUD BUILD: create apps/mobile/.env.production.local (used by `pnpm build` and `pnpm android:debug`)
# and, for `pnpm dev`, apps/mobile/.env.development.local, with:
#
#   VITE_SUPABASE_URL=https://<your-linqora-books-project-ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...      # or the legacy "anon" key
#
# ONLY the publishable/anon key belongs here. The app refuses to start with a secret
# (sb_secret_...) or service_role key. Never put the database password here.
#
# LOCAL PREVIEW (no cloud, on-device prototype, clearly labelled): enabled by
# .env.development and .env.preview-local (committed). Never used when Supabase is set.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ALLOW_LOCAL_PREVIEW=false
