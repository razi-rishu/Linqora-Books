<?xml version="1.0" encoding="utf-8"?>
<!--
  Linqora Books (local development / Phase 1): financial records are stored only in
  the app's private storage (WebView localStorage), unencrypted. They must not leave
  the device through Android Auto Backup (Google Drive) or device-to-device transfer
  (e.g. moving to a new phone), so every domain is excluded from both.

  Android 12+ (API 31+) uses these rules. On Android 12+, android:allowBackup="false"
  alone still permits device-to-device transfer, which is why this file is needed.
  Android 11 and lower: android:allowBackup="false" disables backup entirely.

  Revisit in Phase 2: with cloud accounts the server is the system of record, and
  local caches/tokens must still stay excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
